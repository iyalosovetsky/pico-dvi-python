    ("snake_x", -62.0, "rear cable hole centre X (seen from the back): past the end of the"
                       " USB-C plug, which points -X from the board edge at ~-25"),
    ("snake_y", 35.0, "rear cable hole centre Y (USB-C at ~33.5, clear of the keyhole)"),
