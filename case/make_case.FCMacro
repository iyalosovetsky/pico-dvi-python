# Parametric enclosure for Waveshare PICO-DVI-LCD 7" + Raspberry Pi Pico 2 W.
#
# Run in FreeCAD (Macro > Macros... > make_case.FCMacro) or headless:
#   freecadcmd -c "exec(open('case/make_case.FCMacro').read())"
# Builds/updates case/case.FCStd with a "Params" spreadsheet; edit values there
# (or the defaults below) and run the macro again. Also exports STL + STEP.
#
# Parts (print without supports):
#   Bezel - front plate, printed face down. Holds the panel in a pocket and
#           drops into the front rebate of the back (its walls run up to the
#           front face), so the side walls are one piece and the seam is hidden.
#   Back  - thin rear cover: its back plate lies on the driver board standoffs.
#           Wall-mount keyholes, a window for the heatsink, an opening over the
#           Pico; printed back down. 4x M3 screws go through bosses in the back
#           into the bezel (self-tapping M3, or heat-set inserts with
#           screw_pilot = 4.0), 2x M3 into the lower board standoffs.
#   Cap   - separate hump over the Pico, glued into the opening with its lip;
#           printed roof down. The USB-C plug lies under the back plate, the
#           cable leaves through a hole in it into the gap behind the case.
#   Feet  - two spacers glued to the bottom of the back, as high as the cap,
#           so the case hangs straight on the wall.
import math
import os

import FreeCAD as App
import Part
from FreeCAD import Vector as V

HERE = os.path.dirname(os.path.abspath(__file__)) if "__file__" in dir() else os.path.join(os.getcwd(), "case")

# name: (default, comment). All sizes in mm, X = width, Y = height (up),
# Z = depth: Z = 0 is the front face, Z grows towards the back. +X points to
# the RIGHT when looking at the BACK (left when looking at the screen).
