    ("corner_r", 6.0, "outer corner radius"),
    ("cavity", 9.4, "panel back to the back plate = top of the board standoffs"
                    " (measured 13 from the panel front minus panel_t)"),
    ("ledge", 3.0, "back cover rim pressing on the panel border"),
    ("cable_side", 4, "cable exit: 0 = bottom wall, 1 = left, 2 = right (seen from the back),"
