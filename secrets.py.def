# Template for secrets.py - copy, fill in, keep out of git (secrets.py is ignored):
#
#   cp secrets.py.def secrets.py
#   mpremote cp secrets.py :secrets.py        # first time, over USB
#   ./ota.sh put secrets.py /secrets.py       # later, over Wi-Fi
#
# The same file is used on the device and by tools/ota.py on the PC.

# --- Wi-Fi (2.4 GHz) --------------------------------------------------------
WIFI_SSID = "your-wifi"
WIFI_PASS = "your-wifi-password"
# HOSTNAME = "picodvi"          # optional, DHCP host name
# NTP_HOST = "pool.ntp.org"     # optional

# --- Home Assistant -----------------------------------------------------------
# MQTT broker (Mosquitto add-on). Also used as the HA address for the REST API.
MQTT_HOST = "192.168.1.10"
# MQTT_PORT = 1883              # optional
MQTT_USER = "mqtt-user"
MQTT_PASS = "mqtt-password"

# REST API (recommended, no HA configuration needed). Long-lived access token:
# HA -> your profile -> Security -> Long-lived access tokens -> Create token.
# Without HA_TOKEN the dashboard falls back to MQTT statestream (and no weather).
HA_TOKEN = ""
# HA_URL = "http://192.168.1.10:8123"   # optional, default http://<MQTT_HOST>:8123

# --- Over-the-air updates (tools/ota.py, ./ota.sh) -------------------------------
# Any random string, e.g.:  python3 -I -c "import secrets; print(secrets.token_urlsafe(24))"
# Empty = OTA server disabled on the device.
OTA_TOKEN = ""
# IP of the Pico (better: reserve it in the router's DHCP).
OTA_HOST = "192.168.1.50"
